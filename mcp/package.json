{
  "name": "qls-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "MCP server for Qwen Local Studio (local image generation)",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=build/qls-mcp.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:exe": "node scripts/build-exe.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
