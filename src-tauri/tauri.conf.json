{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qwen Local Studio",
  "version": "1.0.0",
  "identifier": "app.qwenlocalstudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Qwen Local Studio",
        "width": 1320,
        "height": 880,
        "minWidth": 880,
        "minHeight": 620,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Qwen Local Studio",
    "shortDescription": "Local AI image generation and editing",
    "longDescription": "Local text-to-image and image editing with Qwen-Image 2.1 via stable-diffusion.cpp. Everything runs on this PC.",
    "category": "Graphics and Design",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/qls-service", "binaries/qls-mcp"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
